# Port ที่ต้องการให้เว็บทำงาน (ค่าเริ่มต้น 3000)
PORT=3000

# Secret Key สำหรับเข้ารหัส Admin Session (Production ต้องมีความยาวอย่างน้อย 32 ตัวอักษร)
# สร้างด้วยคำสั่ง: openssl rand -base64 32 หรือ node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=YOUR_RANDOMLY_GENERATED_32_CHAR_OR_LONGER_SECRET_KEY

# รหัส Admin PIN สำหรับตั้งค่าครั้งแรก (แนะนำให้กำหนดรหัสผ่านที่ปลอดภัยอย่างน้อย 4-8 หลัก)
ADMIN_PIN=YOUR_SECURE_ADMIN_PIN

# Supabase Credentials (ได้จากหน้า Settings -> API ใน Supabase Dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
# สำหรับ Backend Server ใน Production ให้ใช้ Service Role Secret Key เท่านั้น (ห้ามใช้ Anon/Publishable Key)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
